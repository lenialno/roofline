# Qwen3-32B (dense, thinking) в FP8 на 2x80GB через vLLM. Hermes-style tool calls + reasoning parser.
# 40960 это нативный контекст Qwen3-32B. Выше нужен YaRN (раздел Processing Long Texts в карточке модели):
# флаг для своей версии vLLM смотреть через task flags Q=rope, затем поднимать MAX_MODEL_LEN до 131072.
# max-num-seqs 32: по task vram для 2x80GB при промптах около 24k в KV помещается около 33 запросов.
RUNTIME=vllm
MODEL=/models/Qwen3-32B-FP8
SERVED_NAME=qwen3-32b
HOST=0.0.0.0
PORT=8000
TP=2
MAX_MODEL_LEN=40960
GPU_MEM_UTIL=0.90
CUDA_VISIBLE_DEVICES=0,1
EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser hermes --reasoning-parser qwen3 --max-num-seqs 32 --kv-cache-dtype fp8"
