# Qwen3-32B (dense, thinking) в FP8 на 2x80GB через vLLM. Hermes-style tool calls + reasoning parser.
RUNTIME=vllm
MODEL=/models/Qwen3-32B-FP8
SERVED_NAME=qwen3-32b
HOST=0.0.0.0
PORT=8000
TP=2
MAX_MODEL_LEN=65536
GPU_MEM_UTIL=0.90
CUDA_VISIBLE_DEVICES=0,1
EXTRA_ARGS="--enable-auto-tool-choice --tool-call-parser hermes --reasoning-parser qwen3 --max-num-seqs 64 --kv-cache-dtype fp8"
