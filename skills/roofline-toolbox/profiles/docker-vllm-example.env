# Запуск через контейнер: CMD заменяет сборку команды по полям. PORT нужен для health-ожидания.
RUNTIME=vllm
MODEL=/models/Qwen3-32B-FP8
PORT=8000
CMD="docker run --rm --gpus '\"device=0,1\"' --ipc=host -p 8000:8000 -v /models:/models:ro -e HF_HUB_OFFLINE=1 -e VLLM_NO_USAGE_STATS=1 vllm/vllm-openai:v0.11.0 --model /models/Qwen3-32B-FP8 --served-model-name qwen3-32b --tensor-parallel-size 2 --max-model-len 65536 --gpu-memory-utilization 0.90 --enable-auto-tool-choice --tool-call-parser hermes --reasoning-parser qwen3"
